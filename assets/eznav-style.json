{
  "version": 8,
  "name": "EZNav Cambodia",
  "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": { "type": "vector", "url": "__TILE_URI__" }
  },
  "layers": [
    { "id": "background", "type": "background",
      "paint": { "background-color": "#0B0912" } },

    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#16324a" } },

    { "id": "landuse-residential", "type": "fill", "source": "openmaptiles",
      "source-layer": "landuse", "filter": ["==", ["get", "class"], "residential"],
      "paint": { "fill-color": "#181d24" } },

    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "layout": { "visibility": "none" },
      "paint": { "fill-color": "#1d2b22", "fill-opacity": 0.55 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "layout": { "visibility": "none" },
      "paint": { "fill-color": "#1f3327", "fill-opacity": 0.7 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "layout": { "visibility": "none" },
      "paint": {
        "line-color": "#2b4a6b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2.5]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "layout": { "visibility": "none" },
      "paint": { "fill-color": "#2a2a33", "fill-outline-color": "#3a3a45" }
    },
    {
      "id": "aeroway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "minzoom": 11,
      "layout": { "visibility": "none" },
      "paint": { "line-color": "#4a4a55", "line-width": 2 }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 6],
      "layout": { "visibility": "none" },
      "paint": { "line-color": "#5a5a68", "line-dasharray": [3, 2], "line-width": 1.2 }
    },

    { "id": "road-path", "type": "line", "source": "openmaptiles",
      "source-layer": "transportation", "minzoom": 14,
      "filter": ["==", ["get", "class"], "path"],
      "layout": { "visibility": "none", "line-cap": "round" },
      "paint": { "line-color": "#2e3742", "line-dasharray": [2, 2],
                 "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.6, 16, 1.6] } },

    { "id": "road-minor", "type": "line", "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "track"]]],
      "paint": { "line-color": "#2b323c",
                 "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 16, 4] } },

    { "id": "road-secondary", "type": "line", "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]],
      "paint": { "line-color": "#3b4553",
                 "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 16, 7] } },

    { "id": "road-primary", "type": "line", "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["primary", "trunk", "motorway"]]],
      "paint": { "line-color": "#5b6b7e",
                 "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 16, 10] } },

    { "id": "place-label", "type": "symbol", "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "village"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:km"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["NotoSansKhmer-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 16, 12, 24, 16, 30],
        "text-max-width": 8
      },
      "paint": { "text-color": "#e6ebf2", "text-halo-color": "#0b0e12", "text-halo-width": 1.4 } },

    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {
        "visibility": "none",
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["NotoSansKhmer-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 18, 16, 26]
      },
      "paint": { "text-color": "#c9c9d4", "text-halo-color": "#101018", "text-halo-width": 1.2 }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "visibility": "none",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["NotoSansKhmer-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 16, 16, 22]
      },
      "paint": { "text-color": "#7fa6cc", "text-halo-color": "#101018", "text-halo-width": 1.2 }
    },
    {
      "id": "peak-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "mountain_peak",
      "minzoom": 11,
      "layout": {
        "visibility": "none",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["NotoSansKhmer-Regular"],
        "text-size": 16
      },
      "paint": { "text-color": "#a8a894", "text-halo-color": "#101018", "text-halo-width": 1.2 }
    },
    {
      "id": "aerodrome-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "aerodrome_label",
      "minzoom": 11,
      "layout": {
        "visibility": "none",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["NotoSansKhmer-Regular"],
        "text-size": 18
      },
      "paint": { "text-color": "#c9c9d4", "text-halo-color": "#101018", "text-halo-width": 1.2 }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 12,
      "filter": ["in", ["get", "class"], ["literal", ["shop", "restaurant", "fuel", "school", "hospital", "bank", "lodging", "grocery", "cafe", "pharmacy"]]],
      "layout": {
        "visibility": "none",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["NotoSansKhmer-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 18, 17, 24],
        "text-max-width": 8
      },
      "paint": { "text-color": "#b8b8c6", "text-halo-color": "#101018", "text-halo-width": 1.2 }
    },
    {
      "id": "poi-label-minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 13,
      "filter": ["!", ["in", ["get", "class"], ["literal", ["shop", "restaurant", "fuel", "school", "hospital", "bank", "lodging", "grocery", "cafe", "pharmacy"]]]],
      "layout": {
        "visibility": "none",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["NotoSansKhmer-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 15, 16, 17, 20],
        "text-max-width": 8
      },
      "paint": { "text-color": "#9a9aa8", "text-halo-color": "#101018", "text-halo-width": 1.2 }
    },
    {
      "id": "housenumber-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "housenumber",
      "minzoom": 14,
      "layout": {
        "visibility": "none",
        "text-field": ["get", "housenumber"],
        "text-font": ["NotoSansKhmer-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 17, 14, 19, 18]
      },
      "paint": { "text-color": "#8a8a96", "text-halo-color": "#101018", "text-halo-width": 1 }
    }
  ]
}
